# ─────────────────────────────────────────────────────────────────────────
# ImmoRadar — variables d'environnement
# Copiez ce fichier en .env puis renseignez les valeurs.
# Aucune clé API ne doit JAMAIS être exposée au frontend (préfixe NEXT_PUBLIC_
# interdit pour tout secret : elles seraient envoyées au navigateur).
# ─────────────────────────────────────────────────────────────────────────

# --- Base de données (obligatoire) ---------------------------------------
# PostgreSQL. En local : docker run / service postgresql, ou une instance
# managée (Neon, Supabase, Railway, RDS...).
DATABASE_URL="postgresql://immoradar:immoradar_dev_password@localhost:5432/immoradar?schema=public"

# --- Authentification (obligatoire) ---------------------------------------
# Secret utilisé par NextAuth pour signer les sessions/JWT.
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET="changeme-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# --- Géocodage (déjà fonctionnel, sans clé) -------------------------------
# ImmoRadar utilise Nominatim (OpenStreetMap) pour convertir une adresse en
# coordonnées GPS. Gratuit, sans clé, mais soumis à une politique d'usage
# raisonnable (1 req/s). Pour un usage en production à fort trafic, prévoir
# une instance Nominatim self-hosted ou un fournisseur commercial
# (ex: Geoapify, LocationIQ, Google Geocoding) — voir src/lib/geocode.ts.
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
NOMINATIM_USER_AGENT="ImmoRadar/0.1 (contact@example.com)"

# --- Points d'intérêt / analyse de quartier (déjà fonctionnel, sans clé) --
# Overpass API (OpenStreetMap) fournit les commerces, écoles, transports,
# etc. autour d'un logement. Gratuit, sans clé, avec limite de débit.
OVERPASS_BASE_URL="https://overpass-api.de/api/interpreter"

# --- IA / recherche en langage naturel (OPTIONNEL) ------------------------
# Si absente, ImmoRadar utilise un analyseur de critères basé sur des règles
# (fonctionnel mais plus limité). Si présente, un modèle Claude structure la
# demande en langage naturel en filtres avec une meilleure compréhension.
# Obtenir une clé : https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# --- Calcul de temps de trajet (OPTIONNEL — nécessaire pour activer le
# module "Temps de trajet" avec des données réelles multi-modes) -----------
# Sans clé : le module reste visible mais affiche "non configuré".
# Fournisseurs possibles : Mapbox Directions API, Google Distance Matrix API,
# OpenRouteService (a un plan gratuit généreux, recommandé pour démarrer).
# https://openrouteservice.org/dev/#/signup
ORS_API_KEY=""

# --- Notifications d'alertes par e-mail (OPTIONNEL — nécessaire pour que
# les alertes envoient réellement des e-mails) -----------------------------
# Sans clé : les alertes sont créées et évaluées, mais la notification reste
# "en file d'attente" au lieu d'être envoyée.
# Fournisseur recommandé : Resend (https://resend.com/) — clé API + domaine
# d'expédition vérifié.
RESEND_API_KEY=""
ALERTS_FROM_EMAIL="alertes@immoradar.example"

# Secret partagé pour déclencher /api/cron/alerts depuis un scheduler externe
# (Vercel Cron, GitHub Actions...). Générer avec : openssl rand -hex 32
CRON_SECRET=""

# Secret partagé pour déclencher POST /api/admin/seed (charge/recharge les
# données de démonstration). Utile quand la base n'est joignable que depuis
# l'environnement de déploiement. Générer avec : openssl rand -hex 32
SEED_SECRET=""

# --- Connecteurs de sources immobilières (TOUS OPTIONNELS) ----------------
# ImmoRadar fonctionne dès maintenant avec des données de démonstration.
# Chaque connecteur ci-dessous reste "en attente" tant que la clé/l'accès
# officiel correspondant n'est pas fourni. Voir src/lib/connectors/ pour le
# détail de ce qui est nécessaire pour activer chaque source.
LEBONCOIN_API_KEY=""
SELOGER_API_KEY=""
BIENICI_API_KEY=""
PAP_API_KEY=""
LOGICIMMO_API_KEY=""

# --- Statistiques de prix (OPTIONNEL — améliore l'analyse de prix) --------
# DVF (Demandes de Valeurs Foncières) est un jeu de données public français
# des transactions immobilières. Utile pour affiner l'estimation de prix.
# https://www.data.gouv.fr/fr/datasets/demandes-de-valeurs-foncieres/
DVF_DATASET_URL=""
